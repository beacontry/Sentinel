# Database
DATABASE_URL=postgres://sentinel:sentinel@localhost:5434/sentinel

# Authentication
# Both must be 32+ chars in production. Generate with `openssl rand -hex 32`.
JWT_SECRET=your-jwt-secret-here
ENCRYPTION_KEY=your-encryption-key-here

# Market Data
FINNHUB_API_KEY=your-finnhub-api-key
MARKET_DATA_PROVIDER=yahoo

# AI
ANTHROPIC_API_KEY=your-anthropic-api-key

# Background Jobs
CRON_SECRET=your-cron-secret-here

# IBKR Trader Integration
TRADER_SECRET=your-trader-secret-here

# Push Notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# Email (Resend) — invite + alert delivery
# Sign up at https://resend.com (free tier: 100/day, 3K/mo).
# Without RESEND_API_KEY, /api/admin/invites still creates invites and returns a copyable
# signup link, but no email is sent (graceful fallback in src/lib/email.ts).
# EMAIL_FROM domain must be verified in Resend — for the GuardCyber stack, the apex
# guardcybersolutionsllc.com is the shared verified sender domain.
RESEND_API_KEY=
EMAIL_FROM=Sentinel <noreply@guardcybersolutionsllc.com>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Live Trading Safeguard (Phase 3)
# When unset or any value other than "1", the engine refuses to start against
# any broker connection with environment="live" — paper-only is the default.
# Set ALLOW_LIVE_TRADING=1 to unlock live trading. Even when unlocked, the
# engine still enforces: notional cap, order rate limit, broker-failure halt,
# account-switch detection, and consecutive-loss halt. The Trader page shows
# a persistent red LIVE banner whenever the engine is running on a live
# connection. Read CLAUDE.md § "Live trading" before flipping this on.
ALLOW_LIVE_TRADING=
